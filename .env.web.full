# NOCA -- Web module
#
# The contest administration and participant app (noca-web).
#
# Loaded by: web
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Maximum allowed audio upload size in bytes (up to 5 MiB)
NOCA_AUDIO_MAX_FILE_SIZE=2097152

# Bind address for the web HTTP server
# Keep 0.0.0.0 in container deployments: Caddy connects over the container network
# and the container healthcheck probes loopback
NOCA_WEB_HOST=0.0.0.0

# TCP port for the web HTTP server (1-65535); also drives the Caddy upstream and healthcheck
NOCA_WEB_PORT=8000

# JWT issuer; must differ from NOCA_ARENA_APP_NAME to prevent cross-server token acceptance
NOCA_WEB_APP_NAME=noca

# Public brand name shown in UI, titles, footer, and credential emails
NOCA_WEB_BRAND_NAME=NOCA Contest

# (empty) Public base URL for web emails and reports, e.g. https://contest.example.com
# Leave empty to derive from the incoming request — may produce incorrect URLs behind a reverse proxy
NOCA_WEB_URL_BASE=

# --- Problem storage ---
# (required) Directory where problem statement PDFs are stored
NOCA_WEB_PROBLEM_STATEMENT_DIR=

# (required in production) Cache directory backing BOTH problem-package caches:
# the post-contest problem-set archives (GET /problem-set/{slug}.zip) and the
# per-problem contestant packages (GET /c/{slug}/problems/{label}/export, in a
# problem-export/ subdirectory). Absolute path; both directories are created at
# startup. Each archive is built once and reused, with a sidecar guarding
# integrity and, for the per-problem packages, freshness.
# Web REFUSES TO START in production when this is empty: the per-problem export
# is contestant-facing during a live contest, and a missing cache would surface
# as a 503 mid-contest rather than as a failed deploy. When empty outside
# production, every download rebuilds — fine for development.
NOCA_WEB_PUBLIC_PROBLEM_PACK_PATH=

# --- Clarification Reaper ---
# Enable the in-process clarification reaper
NOCA_WEB_ENABLE_CLARIFICATION_REAPER=false

# How often the clarification reaper runs (180–1800 s)
NOCA_WEB_CLARIFICATION_REAPER_INTERVAL_SECONDS=1800  # 180 to 1800 seconds

# --- Task Reaper ---
# Enable the in-process task reaper
NOCA_WEB_ENABLE_TASK_REAPER=false

# How often the task reaper runs (180–1800 s)
NOCA_WEB_TASK_REAPER_INTERVAL_SECONDS=1800  # 180 to 1800 seconds

# --- Team presence ---
# Tracks which teams are active right now, so the scoreboard's absence marker
# means "no sign of life" rather than "has not signed in since the start".
# Rides the contest clock (every contest page re-fetches it every 60 s), so it
# needs no extra polling. Turning it off marks a team that logged in before the
# contest opened and never signed in again.
NOCA_WEB_PRESENCE_ENABLED=true

# Seconds a team stays "present" after its last page activity (60-900)
NOCA_WEB_PRESENCE_TTL_SECONDS=180

# --- Session-Lock Reaper ---
# Clears the single-session IP bindings (users.locked_ip) of contests that have
# ended. Only matters when a contest is re-run by moving its start time: it
# would otherwise enforce against addresses recorded at the previous sitting.
# A re-run staged as a NEW contest carries no bindings, so this can stay off.
NOCA_WEB_ENABLE_SESSION_LOCK_REAPER=false

# How often the session-lock reaper runs (180–1800 s)
NOCA_WEB_SESSION_LOCK_REAPER_INTERVAL_SECONDS=1800  # 180 to 1800 seconds

# Security-events retention reaper interval in seconds (1 hour to 7 days)
NOCA_WEB_SECURITY_EVENTS_REAPER_INTERVAL_SECONDS=86400

# --- Worker presence ---
# (empty) Stable identity for the worker-presence keys. Defaults to <fqdn>:<pid>
NOCA_WEB_WORKER_ID=

# Seconds between worker-presence updates in Valkey (1–300 s)
NOCA_WEB_WORKER_PRESENCE_INTERVAL_SECONDS=30.0

# TTL for the live worker marker (2–3600 s); must exceed the interval
NOCA_WEB_WORKER_PRESENCE_TTL_SECONDS=60

# --- Submission Form ---
# When true, the submission form shows the compile and run commands
NOCA_WEB_SHOW_COMPILE_RUN_CMDS=false

# --- Submission rate limiting ---
# Rolling window in seconds for per-team submission rate limiting (TEAM users only)
NOCA_WEB_SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60

# Maximum submissions a team may send within the rate-limit window
NOCA_WEB_SUBMISSION_RATE_LIMIT_MAX_SUBMISSIONS=3

# --- Team write rate limiting ---
# Per-team caps on SOS tasks, print requests, and clarifications, counted in PostgreSQL.
# Set any maximum to 0 to disable that one rule; the windows must stay positive.
# The open-count rules are released by staff action (finishing a task, answering a question),
# not by time. Judges, staff, and admins cannot use these routes and are unaffected.
# Rolling window in seconds for both team task budgets
NOCA_WEB_TEAM_TASK_RATE_LIMIT_WINDOW_SECONDS=600

# SOS tasks a team may create within the window
NOCA_WEB_TEAM_TASK_RATE_LIMIT_MAX_SOS_REQUESTS=5

# Unfinished SOS tasks a team may hold at once
NOCA_WEB_TEAM_TASK_RATE_LIMIT_MAX_OPEN_SOS=3

# Print tasks a team may create within the window (applied after the duplicate check)
NOCA_WEB_TEAM_TASK_RATE_LIMIT_MAX_PRINT_REQUESTS=10

# Rolling window in seconds for team clarification requests
NOCA_WEB_CLARIFICATION_RATE_LIMIT_WINDOW_SECONDS=600

# Clarifications a team may ask within the window
NOCA_WEB_CLARIFICATION_RATE_LIMIT_MAX_REQUESTS=5

# Unanswered clarifications a team may hold at once (hidden ones do not count)
NOCA_WEB_CLARIFICATION_RATE_LIMIT_MAX_UNANSWERED=3

# --- Mass rejudge cooldown ---
# Seconds after a batch-wide "Rejudge All Pending" during which another batch-wide
# rejudge of the same problem is refused (per-language rejudges are exempt). 0 disables.
NOCA_WEB_REJUDGE_COOLDOWN_SECONDS=300

# --- SSE connection limits ---
# Cap concurrent SSE streams (per client IP, per user) across this module's event routes
NOCA_WEB_SSE_LIMIT_ENABLED=true

# Open SSE streams allowed per client IP. A shared NAT counts as one client and every
# contestant page holds two streams, so this is a venue's budget (~100 machines), not a client's
NOCA_WEB_SSE_MAX_PER_IP=200

# Open SSE streams allowed per authenticated user, across IPs
NOCA_WEB_SSE_MAX_PER_USER=10

# Lease lifetime in Valkey of one held slot; renewed while the stream is open
NOCA_WEB_SSE_CONNECTION_TTL_SECONDS=600

# Comma-separated CIDRs exempt from the SSE caps (loopback, trusted venue network)
NOCA_WEB_SSE_TRUSTED_CIDRS=127.0.0.0/8,::1/128

# --- Per-actor read ceiling ---
# Loose ceiling on Web's polled partials and contest reads (runs, tasks,
# clarifications, admin counters, job status, problem pages, scoreboard).
# Generous on purpose: a browser refreshes these every 5-60 seconds
NOCA_WEB_USER_READ_RATE_LIMIT_ENABLED=true

NOCA_WEB_USER_READ_RATE_LIMIT_MAX_REQUESTS=300

NOCA_WEB_USER_READ_RATE_LIMIT_WINDOW_SECONDS=60

# --- Per-problem export limit ---
# Tight per-actor budget on GET /c/{slug}/problems/{label}/export, stacked under
# the loose ceiling above. Building one problem package is expensive and the route
# is reachable by every team, so this is deliberately far smaller than the ceiling.
# It applies whether or not the export is served from cache.
NOCA_WEB_PROBLEM_EXPORT_RATE_LIMIT_ENABLED=true

# Problem package downloads accepted per actor in each window (a contestant downloads once)
NOCA_WEB_PROBLEM_EXPORT_RATE_LIMIT_MAX_REQUESTS=10

# Fixed-window length in seconds for per-actor problem package downloads
NOCA_WEB_PROBLEM_EXPORT_RATE_LIMIT_WINDOW_SECONDS=600

# --- Contest-admin export limit ---
# Per-actor budget on the contest-admin downloads: the full problem package,
# the Animeitor archive, the timeline, the users-per-site report and the users
# JSON (bucket web:admin-export). Each builds per request and grows with the contest.
NOCA_WEB_ADMIN_EXPORT_RATE_LIMIT_ENABLED=true

# Contest-admin downloads accepted per actor in each window
NOCA_WEB_ADMIN_EXPORT_RATE_LIMIT_MAX_REQUESTS=20

# Fixed-window length in seconds
NOCA_WEB_ADMIN_EXPORT_RATE_LIMIT_WINDOW_SECONDS=600

# --- Contest reports page limit ---
# Per-actor budget on GET /c/{slug}/reports/ (bucket web:contest-report), which
# aggregates every submission per hit. Looser than the downloads: staff refresh
# and re-scope it by site while a contest runs.
NOCA_WEB_CONTEST_REPORT_RATE_LIMIT_ENABLED=true

# Reports page loads accepted per actor in each window
NOCA_WEB_CONTEST_REPORT_RATE_LIMIT_MAX_REQUESTS=60

# Fixed-window length in seconds
NOCA_WEB_CONTEST_REPORT_RATE_LIMIT_WINDOW_SECONDS=600

# --- Team submissions download limit ---
# Per-team budget on GET /c/{slug}/submissions/download-all (bucket
# web:team-download), the one heavy export a team reaches. A team downloads
# its own sources once.
NOCA_WEB_TEAM_DOWNLOAD_RATE_LIMIT_ENABLED=true

# Own-submissions ZIP downloads accepted per team in each window
NOCA_WEB_TEAM_DOWNLOAD_RATE_LIMIT_MAX_REQUESTS=5

# Fixed-window length in seconds
NOCA_WEB_TEAM_DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS=600

# --- UberAdmin security-events export limit ---
# Per-UberAdmin budget on GET /uberadmin/security-events.csv (bucket
# web:uberadmin-export), which streams the whole Web security-event log.
NOCA_WEB_UBERADMIN_EXPORT_RATE_LIMIT_ENABLED=true

# Security-events CSV downloads accepted per UberAdmin in each window
NOCA_WEB_UBERADMIN_EXPORT_RATE_LIMIT_MAX_REQUESTS=10

# Fixed-window length in seconds
NOCA_WEB_UBERADMIN_EXPORT_RATE_LIMIT_WINDOW_SECONDS=600

# --- Public read rate limiting ---
# Per-IP fixed windows on the anonymous GET /problem-set/{slug}.zip and GET /c/{slug}/live/feed.json,
# checked before the contest gate. In production the download also answers 503 while
# NOCA_WEB_PUBLIC_PROBLEM_PACK_PATH is unset -- though Web refuses to start in that state.
NOCA_WEB_PUBLIC_RATE_LIMIT_ENABLED=true

# Comma-separated CIDRs exempt from both public read limits
NOCA_WEB_PUBLIC_RATE_LIMIT_TRUSTED_CIDRS=127.0.0.0/8,::1/128

# Problem-set downloads accepted per client IP in each window (a human downloads once)
NOCA_WEB_PUBLIC_RATE_LIMIT_PROBLEM_SET_MAX_REQUESTS=10

# Fixed-window length in seconds for problem-set downloads
NOCA_WEB_PUBLIC_RATE_LIMIT_PROBLEM_SET_WINDOW_SECONDS=600

# Live-feed snapshot requests accepted per client IP in each window (refetched per SSE ping, debounced)
NOCA_WEB_PUBLIC_RATE_LIMIT_LIVE_FEED_MAX_REQUESTS=120

# Fixed-window length in seconds for live-feed snapshot requests
NOCA_WEB_PUBLIC_RATE_LIMIT_LIVE_FEED_WINDOW_SECONDS=60

# --- UberAdmin Bootstrap ---
# Container startup creates the UberAdmin account only when NOCA_WEB_UBERADMIN_USERNAME is set.
# The script is idempotent — if the username already exists it exits cleanly.
# (empty) Username for the bootstrap UberAdmin account
NOCA_WEB_UBERADMIN_USERNAME=

# (empty) Full name for the bootstrap UberAdmin account
NOCA_WEB_UBERADMIN_FULLNAME=

# (empty) Email address for the bootstrap UberAdmin account
NOCA_WEB_UBERADMIN_EMAIL=

# (empty) Password for the bootstrap UberAdmin account
NOCA_WEB_UBERADMIN_PASSWORD=
