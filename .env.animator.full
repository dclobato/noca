# NOCA -- Animator
#
# The public live scoreboard and reveal presentation runtime (noca-animator).
#
# Loaded by: animator
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Live scoreboard/reveal presentation runtime: public scoreboard + SSE feed, plus the
# post-freeze reveal ceremony and its authenticated operator control API.
# Reads PostgreSQL (common NOCA_DB_*) and Valkey (common NOCA_VALKEY_*) directly; no JWT.
# Also honours NOCA_STARTUP_TIMEOUT_SECONDS, NOCA_LOG_LEVEL, NOCA_FORWARDED_ALLOW_IPS
# (needed behind a proxy so the control audit log records the operator IP, not the proxy),
# and the NOCA_HEALTH_RATE_LIMIT_* settings. The anonymous /meta, /snapshot and /reveal/state
# feeds have their own per-IP bucket, configured by the public feed settings below.
# Bind address for the animator HTTP server
# Keep 0.0.0.0 in container deployments: Caddy connects over the container network
# and the container healthcheck probes loopback
NOCA_ANIMATOR_HOST=0.0.0.0

# TCP port for the animator HTTP server (1-65535; avoids 8000/8001/8002)
# Also drives the Caddy upstream and the container healthcheck
NOCA_ANIMATOR_PORT=8003

# Fallback snapshot re-poll interval in seconds when the SSE stream is unavailable (1 s to 1 h)
NOCA_ANIMATOR_POLL_FALLBACK_SECONDS=15

# Kill-switch for the reveal control endpoints; while false they answer 404 regardless of operator secrets
NOCA_ANIMATOR_ENABLE_CONTROL=false

# Lock an IP out of the operator-token gate after repeated credential failures
NOCA_ANIMATOR_CONTROL_LOCKOUT_ENABLED=true

# Credential failures from one IP inside one window that trigger the lockout
NOCA_ANIMATOR_CONTROL_LOCKOUT_FAILURES=10

# Lockout duration in seconds (also the failure-count window); locked answers stay a generic 403
NOCA_ANIMATOR_CONTROL_LOCKOUT_SECONDS=300

# Seconds added to contest-end for a reveal session's Valkey TTL (refreshed each mutation; 60 s to 24 h)
NOCA_ANIMATOR_REVEAL_TTL_MARGIN_SECONDS=3600

# Active-controller lease TTL and heartbeat interval; TTL must be at least 3x heartbeat
NOCA_ANIMATOR_CONTROLLER_LEASE_TTL_SECONDS=45

NOCA_ANIMATOR_CONTROLLER_HEARTBEAT_SECONDS=10

# Lifetime of one projector's presence entry (its open /reveal/events stream) per ceremony
# scope; renewed at a third of this value while the stream is open (5 s to 10 min)
NOCA_ANIMATOR_PROJECTOR_PRESENCE_TTL_SECONDS=30

# Brand name shown on the animator pages
NOCA_ANIMATOR_BRAND_NAME=NOCA Animator

# Seconds a built /snapshot is served from the per-process cache while the contest runs;
# verdict and submission events drop it earlier (1 s to 1 h)
NOCA_ANIMATOR_SNAPSHOT_CACHE_SECONDS=5

# Seconds a /snapshot is cached once the contest has ended (1 s to 24 h)
NOCA_ANIMATOR_SNAPSHOT_CACHE_ENDED_SECONDS=60

# Seconds a built /meta is served from the per-process cache (1 s to 1 h)
NOCA_ANIMATOR_META_CACHE_SECONDS=30

# Seconds a ceremony's frozen dataset stays cached between reveal commands and spectator
# state reads; a new start-reveal or restart always reloads it (1 s to 24 h)
NOCA_ANIMATOR_REVEAL_DATASET_CACHE_SECONDS=300

# Enable per-IP rate limiting of the anonymous /meta, /snapshot and /reveal/state feeds and
# the team photo/audio routes; /health uses the shared NOCA_HEALTH_RATE_LIMIT_* settings instead
NOCA_ANIMATOR_PUBLIC_RATE_LIMIT_ENABLED=true

# Requests accepted per client IP in each fixed window, shared by the five public routes
# (a scoreboard tab in poll fallback issues four per minute; a projector one per reveal step;
# the team modal one photo and optional clip per click)
NOCA_ANIMATOR_PUBLIC_RATE_LIMIT_MAX_REQUESTS=300

# Fixed-window length in seconds for public-route rate limiting
NOCA_ANIMATOR_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated CIDRs exempt from public-route rate limiting (loopback, venue projectors)
NOCA_ANIMATOR_PUBLIC_RATE_LIMIT_TRUSTED_CIDRS=127.0.0.0/8,::1/128

# --- SSE connection limits ---
# Cap concurrent SSE streams (per client IP) across this module's event routes
NOCA_ANIMATOR_SSE_LIMIT_ENABLED=true

# Open SSE streams allowed per client IP (a shared NAT counts as one client, so this is a
# venue's budget; the process-wide NOCA_ANIMATOR_MAX_SSE_CLIENTS ceiling is the capacity bound)
NOCA_ANIMATOR_SSE_MAX_PER_IP=100

# Lease lifetime in Valkey of one held slot; renewed while the stream is open
NOCA_ANIMATOR_SSE_CONNECTION_TTL_SECONDS=600

# Comma-separated CIDRs exempt from the SSE caps (loopback, trusted venue network)
NOCA_ANIMATOR_SSE_TRUSTED_CIDRS=127.0.0.0/8,::1/128

# Hard per-process ceiling on open SSE clients across /events and /reveal/events (503 when full)
NOCA_ANIMATOR_MAX_SSE_CLIENTS=2000

# (empty) Stable identity for the presence keys. Defaults to <fqdn>:<pid>
NOCA_ANIMATOR_WORKER_ID=

# Seconds between worker-presence updates in Valkey (1-300 s)
NOCA_ANIMATOR_WORKER_PRESENCE_INTERVAL_SECONDS=30.0

# TTL for the live worker marker (2-3600 s); must exceed the interval above
NOCA_ANIMATOR_WORKER_PRESENCE_TTL_SECONDS=60
