# NOCA Complete Environment Configuration (.env.full)
# Extracted from docs/CONFIG.md

# ==============================================================================
# Common — all modules
# ==============================================================================

# --- Database (PostgreSQL) ---
# (required) PostgreSQL username
NOCA_DB_USER=
# (required) PostgreSQL password
NOCA_DB_PASSWORD=
# (required) Hostname or IP of the PostgreSQL server (e.g. 127.0.0.1 or postgres)
# On Windows use 127.0.0.1 instead of localhost — asyncpg tries IPv6 first when given a hostname,
# causing a ~20s timeout before falling back to IPv4
NOCA_DB_SERVER=
# PostgreSQL port (1–65535)
NOCA_DB_PORT=5432
# (required) Name of the PostgreSQL database
NOCA_DB_NAME=

# --- Valkey / Redis ---
# Docker Compose: NOCA_DB_SERVER and NOCA_VALKEY_SERVER must be reachable from inside the
# container — do not use localhost unless the service runs in the same container namespace.
# Use the Compose service name (e.g. postgres, valkey) instead.
# Hostname of the Valkey server
NOCA_VALKEY_SERVER=127.0.0.1
# Valkey port (1–65535)
NOCA_VALKEY_PORT=6379
# Valkey logical database index (0 or greater)
NOCA_VALKEY_DB=0
# (empty) Valkey username for ACL authentication; leave empty if auth is not configured
NOCA_VALKEY_USER=
# (empty) Valkey password; leave empty if auth is not configured
NOCA_VALKEY_PASSWORD=
# How often the app pings Valkey and attempts reconnection (1–300 s)
NOCA_VALKEY_HEALTHCHECK_INTERVAL_SECONDS=5  # 1 to 300 seconds
# Seconds to wait for PostgreSQL/Valkey at startup before aborting (0 = no wait)
NOCA_STARTUP_TIMEOUT_SECONDS=60

NOCA_WORKER_COMMAND_SECRET=

# --- Health rate limiting ---
# Enable public /health endpoint rate limiting in Web and Arena
NOCA_HEALTH_RATE_LIMIT_ENABLED=true
# Fixed-window length in seconds for /health rate limiting
NOCA_HEALTH_RATE_LIMIT_WINDOW_SECONDS=60
# Maximum public /health requests per client IP in each window
NOCA_HEALTH_RATE_LIMIT_MAX_REQUESTS=30
# CIDRs that bypass /health rate limiting, usually local probe networks
NOCA_HEALTH_RATE_LIMIT_TRUSTED_CIDRS=127.0.0.0/8,::1/128

# --- Security headers and auth throttling ---
# Enable browser security headers on Web and Arena responses
NOCA_SECURITY_HEADERS_ENABLED=true
# Start CSP in report-only mode; set false only after validating asset coverage
NOCA_CSP_REPORT_ONLY=true
# Enable Valkey-backed auth throttling on login, 2FA, password reset, and signup
NOCA_AUTH_RATE_LIMIT_ENABLED=true
# Failure-count window in seconds
NOCA_AUTH_RATE_LIMIT_WINDOW_SECONDS=900
# Maximum auth failures per ASGI client IP in the window
NOCA_AUTH_RATE_LIMIT_IP_MAX_FAILURES=20
# Maximum auth failures per hashed account identifier in the window
NOCA_AUTH_RATE_LIMIT_ACCOUNT_MAX_FAILURES=5
# Lockout duration in seconds
NOCA_AUTH_RATE_LIMIT_LOCKOUT_SECONDS=900
# Days to retain security_events rows before the retention reaper deletes them
NOCA_SECURITY_EVENTS_RETENTION_DAYS=180

# --- Environment / logging ---
# Runtime environment (development/production)
NOCA_ENVIRONMENT=development
# Logging level honored by all modules: DEBUG, INFO, WARNING, ERROR, CRITICAL
# When unset, falls back to DEBUG in development and INFO in production
NOCA_LOG_LEVEL=

# --- Cookies / secrets ---
# Set the Secure attribute on session cookies.
# Production startup fails unless this is true. Run Web/Arena behind HTTPS or
# behind a trusted TLS-terminating reverse proxy that preserves secure cookies.
NOCA_COOKIE_SECURE=false
# Dotenv file holding secrets-manager keys (used by arena and aiassistant)
NOCA_CRYPTO_ENV_FILE=.env.crypto


# ==============================================================================
# Shared between Web and Arena
# ==============================================================================

# Comma-separated trusted reverse proxy IPs/CIDRs for X-Forwarded-* headers
# Use '*' only in trusted private networks — it trusts any upstream IP
NOCA_FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- JWT ---
# (required) Secret key used to sign JWT tokens
NOCA_JWT_SECRET_KEY=
# JWT signing algorithm
NOCA_JWT_ALGORITHM=HS256
# Per-token JWT lifetime in seconds; active sessions refresh at half-life
NOCA_JWT_EXPIRE_SECONDS=3600
# Optional absolute cap for sliding web sessions in seconds; 0 disables the cap
NOCA_JWT_REFRESH_MAX_SESSION_SECONDS=0

# --- Email ---
# Enable real email delivery
NOCA_SEND_EMAIL=false
# Email backend: mock or smtp
NOCA_EMAIL_PROVIDER=mock
# Default From address
NOCA_EMAIL_SENDER=no-reply@noca.local
# (empty) Optional From display name
NOCA_EMAIL_SENDER_NAME=
# (empty) SMTP server hostname
NOCA_SMTP_SERVER=
# SMTP port (1–65535)
NOCA_SMTP_PORT=587
# Use STARTTLS
NOCA_SMTP_USE_TLS=true
# (empty) SMTP username
NOCA_SMTP_USERNAME=
# (empty) SMTP password
NOCA_SMTP_PASSWORD=
# (empty) Absolute directory for the mbox audit log of sent emails; empty disables logging
NOCA_EMAIL_MBOX_LOG_DIR=

# --- Geolocation ---
# (empty) API key for the geolocation service (get a key at ipgeolocation.io)
NOCA_GEOLOCATION_API_KEY=

# --- Password Policy ---
# Filename of the wordlist used for diceware password generation
NOCA_WORDLIST_FILENAME=wordlist-pt.txt
# Number of words in generated diceware passwords
NOCA_PASSWORD_WORD_COUNT=4
# Minimum character length required for any password (minimum 8)
NOCA_MIN_PASSWORD_LENGTH=12
# Require at least one uppercase letter in generated passwords
NOCA_PASSWORD_UPPERCASE_REQUIRED=true
# Require at least one lowercase letter in generated passwords
NOCA_PASSWORD_LOWERCASE_REQUIRED=true
# Require at least one digit in generated passwords
NOCA_PASSWORD_NUMBER_REQUIRED=true
# Require at least one symbol in generated passwords
NOCA_PASSWORD_SYMBOL_REQUIRED=true

# --- Images ---
# Maximum size in pixels for generated avatars (up to 256)
NOCA_IMAGE_AVATAR_SIZE=64
# Maximum allowed upload size in bytes (up to 5 MiB)
NOCA_IMAGE_MAX_FILE_SIZE=5242880
# Maximum allowed upload width in pixels (up to 4096)
NOCA_IMAGE_MAX_WIDTH=2048
# Maximum allowed upload height in pixels (up to 4096)
NOCA_IMAGE_MAX_HEIGHT=2048
# (empty) Optional directory containing fonts used by generated placeholder images
NOCA_IMAGE_FONT_DIR=
# Cache-Control: max-age value for image responses in seconds
NOCA_IMAGE_RESPONSE_CACHE_MAX_AGE=3600


# ==============================================================================
# Shared problem storage
# ==============================================================================

# (required) Shared root directory where Web, Arena, and Autojudge store/read test cases
NOCA_PROBLEM_TESTCASE_DIR=


# ==============================================================================
# Web module
# ==============================================================================

# Application name used in titles and generated content
NOCA_WEB_APP_NAME=noca
# (empty) Public base URL for web emails and reports, e.g. https://contest.example.com
# Leave empty to derive from the incoming request — may produce incorrect URLs behind a reverse proxy
NOCA_WEB_URL_BASE=

# --- Problem storage ---
# (required) Directory where problem statement PDFs are stored
NOCA_WEB_PROBLEM_STATEMENT_DIR=

# --- Clarification Reaper ---
# Enable the in-process clarification reaper
NOCA_WEB_ENABLE_CLARIFICATION_REAPER=false
# How often the clarification reaper runs (180–1800 s)
NOCA_WEB_CLARIFICATION_REAPER_INTERVAL_SECONDS=1800  # 180 to 1800 seconds

# --- Task Reaper ---
# Enable the in-process task reaper
NOCA_WEB_ENABLE_TASK_REAPER=false
# How often the task reaper runs (180–1800 s)
NOCA_WEB_TASK_REAPER_INTERVAL_SECONDS=1800  # 180 to 1800 seconds
# Security-events retention reaper interval in seconds (1 hour to 7 days)
NOCA_WEB_SECURITY_EVENTS_REAPER_INTERVAL_SECONDS=86400

# --- Submission Form ---
# When true, the submission form shows the compile and run commands
NOCA_WEB_SHOW_COMPILE_RUN_CMDS=false

# --- Submission rate limiting ---
# Rolling window in seconds for per-team submission rate limiting (TEAM users only)
NOCA_WEB_SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=60
# Maximum submissions a team may send within the rate-limit window
NOCA_WEB_SUBMISSION_RATE_LIMIT_MAX_SUBMISSIONS=3

# --- UberAdmin Bootstrap ---
# Container startup creates the UberAdmin account only when NOCA_WEB_UBERADMIN_USERNAME is set.
# The script is idempotent — if the username already exists it exits cleanly.
# (empty) Username for the bootstrap UberAdmin account
NOCA_WEB_UBERADMIN_USERNAME=
# (empty) Full name for the bootstrap UberAdmin account
NOCA_WEB_UBERADMIN_FULLNAME=
# (empty) Email address for the bootstrap UberAdmin account
NOCA_WEB_UBERADMIN_EMAIL=
# (empty) Password for the bootstrap UberAdmin account
NOCA_WEB_UBERADMIN_PASSWORD=


# ==============================================================================
# Arena module
# ==============================================================================

# Application name used in titles, generated content, and JWT issuer claims
NOCA_ARENA_APP_NAME=noca-arena
# (empty) Public base URL for Arena emails, e.g. https://arena.example.com
# Leave empty to derive from the incoming request — may produce incorrect URLs behind a reverse proxy
NOCA_ARENA_URL_BASE=
# Maximum password age in days before a warning flash is shown at login
NOCA_ARENA_PASSWORD_MAX_AGE=0
# Submission rate limiting (admins and judges are exempt)
NOCA_ARENA_RATE_LIMIT_WINDOW_MINUTES=5
NOCA_ARENA_RATE_LIMIT_MAX_SUBMISSIONS=10
# Maximum finalized submissions returned by the public Arena live feed
NOCA_ARENA_LIVE_FEED_LIMIT=20
# Enable the online-presence green dot on Arena user avatars
NOCA_ARENA_PRESENCE_ENABLED=true
# Seconds a user stays online after their last heartbeat or page view
NOCA_ARENA_PRESENCE_TTL_SECONDS=60
# Client heartbeat and dot-refresh interval in seconds
NOCA_ARENA_PRESENCE_HEARTBEAT_SECONDS=30
# Security-events retention reaper interval in seconds (1 hour to 7 days)
NOCA_ARENA_SECURITY_EVENTS_REAPER_INTERVAL_SECONDS=86400
# Enables Arena profile browser-coordinate reverse geocoding
NOCA_ARENA_REVERSE_GEOCODER_ENABLED=true
# Reverse-geocoder endpoint
NOCA_ARENA_REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# Optional User-Agent sent to the reverse geocoder; defaults to NOCA_ARENA_APP_NAME/app_version when unset
NOCA_ARENA_REVERSE_GEOCODER_USER_AGENT=

# --- Arena Admin Bootstrap ---
# Container startup creates an ARENA_ADMIN account only when NOCA_ARENA_ADMIN_EMAIL is set.
# The script is idempotent — if the email already exists it exits cleanly.
# (empty) Full name for the bootstrap Arena admin account
NOCA_ARENA_ADMIN_FULLNAME=
# (empty) Email address for the bootstrap Arena admin account (setting this triggers the bootstrap)
NOCA_ARENA_ADMIN_EMAIL=
# (empty) Password for the bootstrap Arena admin account
NOCA_ARENA_ADMIN_PASSWORD=


# ==============================================================================
# Rating worker (noca-rating)
# ==============================================================================

# Seconds between Arena rating recomputation cycles
NOCA_RATING_INTERVAL=86400  # 900 (15 min) to 604800 (1 week); default 86400 (24 h)
# When true, cycles run immediately at startup
NOCA_RATING_COMPUTE_ON_STARTUP=false  # true to run a rating cycle immediately at startup
# Seconds between Arena per-problem statistics recomputation cycles (own timer, independent of NOCA_RATING_INTERVAL)
NOCA_RATING_STATS_INTERVAL=86400  # 900 (15 min) to 604800 (1 week); default 86400 (24 h)
# Geometric decay factor f used in the affiliation rating formula
NOCA_RATING_AFFILIATION_FACTOR=5.0  # 2 to 50; default 5
# Stable identity. Defaults to `<fqdn>:<pid>` when empty
NOCA_RATING_WORKER_ID=
# Seconds between worker-presence updates in Valkey (1–300 s)
NOCA_RATING_PRESENCE_INTERVAL_SECONDS=30.0
# TTL for the live worker marker (2–3600 s)
NOCA_RATING_PRESENCE_TTL_SECONDS=60
NOCA_RATING_BADGE_INTERVAL=900
NOCA_RATING_BADGE_LOOKBACK_SECONDS=600
NOCA_RATING_BADGE_RECONCILE_INTERVAL=86400


# ==============================================================================
# AI Assistant worker (noca-aiassistant)
# ==============================================================================

# --- OpenAI Integration ---
# Leave NOCA_AI_OPENAI_API_KEY empty to disable AI review for users without a personal key.
# Prices are per 1 million tokens in USD; update when the model pricing changes.
# (empty) Platform fallback OpenAI API key (sk-...)
NOCA_AI_OPENAI_API_KEY=
# OpenAI model identifier passed to the Responses API
NOCA_AI_OPENAI_MODEL=gpt-5.4-mini
# Maximum number of output tokens the AI may generate per review
NOCA_AI_OPENAI_MAX_OUTPUT_TOKENS=500
# Price per 1 million input tokens in USD
NOCA_AI_OPENAI_INPUT_TOKEN_PRICE=0.75   # USD per 1M input tokens
# Price per 1 million output tokens in USD
NOCA_AI_OPENAI_OUTPUT_TOKEN_PRICE=4.5  # USD per 1M output tokens
# (empty) Batch input token price in USD per 1 million tokens
NOCA_AI_OPENAI_BATCH_INPUT_TOKEN_PRICE=
# (empty) Batch output token price in USD per 1 million tokens
NOCA_AI_OPENAI_BATCH_OUTPUT_TOKEN_PRICE=
# Stable identity. Defaults to `<fqdn>:<pid>` when empty
NOCA_AI_WORKER_ID=
# Seconds between worker-presence updates in Valkey (1–300 s)
NOCA_AI_PRESENCE_INTERVAL_SECONDS=30.0
# TTL for the live worker marker (2–3600 s)
NOCA_AI_PRESENCE_TTL_SECONDS=60

# --- Queue Polling ---
# Seconds to sleep between poll attempts when the queue is empty
NOCA_AI_POLL_INTERVAL_SECONDS=5.0  # 0.5 to 60 s
# Seconds between scans for pending OpenAI batch jobs
NOCA_AI_BATCH_POLL_INTERVAL_SECONDS=300.0  # 60 to 3600 s
# Hours before a non-terminal OpenAI batch job is expired locally (credit refunded,
# user notified, OpenAI batch cancelled and its files deleted)
NOCA_AI_BATCH_STALE_HOURS=24  # 1 to 168 h
# Seconds between Valkey pause/resume command-key polls
NOCA_AI_WORKER_COMMAND_POLL_SECONDS=3.0
# Symmetric freshness window for accepting a signed worker command
NOCA_AI_WORKER_COMMAND_FRESHNESS_SECONDS=30.0
# TTL for the single-use worker command nonce
NOCA_AI_WORKER_COMMAND_NONCE_TTL_SECONDS=60

# --- Reaper / Reconciler ---
# Age in seconds after which an in-flight AI review job is considered stale
NOCA_AI_STALE_THRESHOLD_SECONDS=300.0
# How often the reaper scans the inflight sorted set for stale jobs
NOCA_AI_REAPER_INTERVAL_SECONDS=60.0
# Maximum number of times a stale AI review job is requeued
NOCA_AI_MAX_REQUEUE_COUNT=3
# How often the reconciler sweeps PostgreSQL for lost AI jobs
NOCA_AI_RECONCILER_INTERVAL_SECONDS=120.0
# Minimum age in seconds since a submission was flagged before reconciler runs
NOCA_AI_RECONCILER_GRACE_SECONDS=120.0
# Maximum number of lost AI review jobs re-enqueued per sweep
NOCA_AI_RECONCILER_BATCH_SIZE=100


# ==============================================================================
# Autojudge worker (noca-autojudge)
# ==============================================================================

# Uses NOCA_PROBLEM_TESTCASE_DIR from the shared problem storage section above
# Maximum number of simultaneous container executions on this host
NOCA_JUDGE_WORKER_CONCURRENCY=4
# (empty) Stable identity string for this worker process. Defaults to <fqdn>:<pid>
NOCA_JUDGE_WORKER_ID=
# Seconds between worker-presence updates in Valkey (1–300 s)
NOCA_JUDGE_PRESENCE_INTERVAL_SECONDS=30.0
# TTL for the live worker marker (2–3600 s)
NOCA_JUDGE_PRESENCE_TTL_SECONDS=60
# Seconds between Valkey pause/resume command-key polls
NOCA_JUDGE_WORKER_COMMAND_POLL_SECONDS=3.0
# Symmetric freshness window for accepting a signed worker command
NOCA_JUDGE_WORKER_COMMAND_FRESHNESS_SECONDS=30.0
# TTL for the single-use worker command nonce
NOCA_JUDGE_WORKER_COMMAND_NONCE_TTL_SECONDS=60
# When true, each language's container pool is lazily filled on first submission
NOCA_JUDGE_PRE_WARM_CONTAINERS=true
# Number of warm idle containers maintained per language
NOCA_JUDGE_POOL_SIZE_PER_LANGUAGE=2
# Upper-bound memory limit applied to pool containers (MB)
NOCA_JUDGE_CONTAINER_MEM_LIMIT_MB=512
# Upper-bound PID limit applied to pool containers
NOCA_JUDGE_CONTAINER_PID_LIMIT=256
# Maximum seconds to wait for a warm container from the pool
NOCA_JUDGE_POOL_ACQUIRE_TIMEOUT_S=30.0

# --- Execution Limits ---
# Absolute path to the isolate binary inside run containers
NOCA_JUDGE_ISOLATE_BINARY_PATH=/usr/local/bin/isolate
# Distinct isolate box-ids the worker allocates from (0 .. value-1). Each live run
# container holds one unique box-id for its lifetime so concurrent containers never
# collide on the shared host cgroup box-N. Must not exceed isolate's num_boxes (default
# 1000); assumes a single autojudge worker process per host.
NOCA_JUDGE_ISOLATE_MAX_BOXES=1000
# Multiplier applied to CPU time limit to compute the inner wall-time budget
NOCA_JUDGE_ISOLATE_WALL_TIME_MULTIPLIER=3.0
# Multiplier applied to wall-time budget for outer timeout
NOCA_JUDGE_OUTER_TIMEOUT_MULTIPLIER=2.0
# Global ceiling for the compile phase in seconds
NOCA_JUDGE_COMPILE_TIMEOUT_S=180.0
# Global hard ceiling for stdout handling per test case in bytes
NOCA_JUDGE_OUTPUT_LIMIT_BYTES=67108864  # 64 MiB
# How many bytes of contestant stdout to persist
NOCA_JUDGE_STDOUT_EXCERPT_BYTES=8192
# How many bytes of contestant stderr to persist
NOCA_JUDGE_STDERR_EXCERPT_BYTES=4096
# Hard CPU-time ceiling applied to profiling
NOCA_JUDGE_PROFILING_MAX_CPU_TIME_SEC=30.0
# Hard wall-time ceiling reserved for profiling runs
NOCA_JUDGE_PROFILING_MAX_WALL_TIME_SEC=90.0
# Hard memory ceiling used while profiling
NOCA_JUDGE_PROFILING_MAX_MEMORY_MB=2048
# Hard process/thread ceiling used while profiling
NOCA_JUDGE_PROFILING_MAX_PIDS=256
# Hard stdout ceiling used while profiling
NOCA_JUDGE_PROFILING_MAX_OUTPUT_BYTES=67108864  # 64 MiB

# --- Idempotency Lock ---
# TTL in seconds for the per-judgment Redis idempotency lock
NOCA_JUDGE_LOCK_TTL_SECONDS=660

# --- Reaper ---
# How often the reaper scans the in-flight sorted set for stale jobs
NOCA_JUDGE_REAPER_INTERVAL_S=30.0
# Dispatched job older than this many minutes is considered stale
NOCA_JUDGE_REAPER_STALE_THRESHOLD_MINUTES=5.0
# Maximum number of times reaper will requeue a stale job
NOCA_JUDGE_REAPER_MAX_REQUEUE_COUNT=3
# How often the reconciler re-scans the DB for lost non-terminal jobs
NOCA_JUDGE_RECONCILER_INTERVAL_S=120.0

# --- Heartbeat ---
# Absolute path to the heartbeat file
NOCA_JUDGE_HEARTBEAT_FILE=/tmp/autojudge-heartbeat
# How often the worker refreshes the heartbeat file in seconds
NOCA_JUDGE_HEARTBEAT_INTERVAL_S=10.0
# Maximum allowed age of the heartbeat file before unhealthy
NOCA_JUDGE_HEARTBEAT_STALE_THRESHOLD_S=30.0

# --- Metrics ---
# Expose a Prometheus /metrics HTTP endpoint
NOCA_JUDGE_METRICS_ENABLED=true
# TCP port the worker binds for Prometheus scraping
NOCA_JUDGE_METRICS_PORT=9101

# --- Docker ---
# Docker daemon socket or TCP address
NOCA_JUDGE_DOCKER_BASE_URL=unix:///var/run/docker.sock
# Network mode for judge containers
NOCA_JUDGE_DOCKER_NETWORK=none
# (empty) Optional AppArmor profile for run containers
# Set to 'unconfined' on Ubuntu hosts where AppArmor blocks isolate mount privatization
NOCA_JUDGE_DOCKER_APPARMOR_PROFILE=

# --- Canonical Judge Image Sync ---
# (empty) Canonical registry/repository prefix for judge images
# e.g. ghcr.io/dclobato/noca or docker.io/dclobato/noca
NOCA_JUDGE_IMAGE_REGISTRY=
# Image naming mode for canonical judge refs
# path => ghcr.io/org/repo/judge-... ; flat => docker.io/org/repo-judge-...
NOCA_JUDGE_IMAGE_NAMING=path
# (empty) Optional tag suffix appended to compile/run image tags, e.g. v5.0.0
NOCA_JUDGE_IMAGE_TAG=
# Startup behavior when canonical image sync is enabled
NOCA_JUDGE_IMAGE_PULL_POLICY=missing


# ==============================================================================
# Docker Compose only
# ==============================================================================

# Host path prepended to all persistent data volume mounts
NOCA_DATA_ROOT=.docker
# UID that processes run as inside their containers
PUID=1000
# Primary GID that processes run as inside their containers
PGID=100
# Set to true to seed the built-in language definitions into the database on startup
NOCA_SEED_LANGUAGES=false


# ==============================================================================
# Build-time only (consumed by containers/build.sh — NOT loaded at runtime)
# ==============================================================================

# Git tag of ioi/isolate compiled into noca/isolate-base
JUDGE_ISOLATE_TAG=v2.3
# Registry prefix applied to every built image tag (e.g. ghcr.io/myorg/noca)
NOCA_IMAGE_PREFIX=noca
# Build-script image naming mode: path or flat
NOCA_IMAGE_NAMING=path
