# NOCA -- Common runtime settings
#
# Environment, log level, Valkey connection, and startup wait. Every NOCA
# Python process reads these.
#
# Loaded by: aiassistant, animator, arena, autojudge, healthmonitor, mailer, rating, web
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Docker Compose: NOCA_VALKEY_SERVER must be reachable from inside the container — do not
# use localhost unless the service runs in the same container namespace. Use the Compose
# service name (e.g. valkey) instead. The same applies to NOCA_DB_SERVER in .env.database.full.
# Hostname of the Valkey server
NOCA_VALKEY_SERVER=127.0.0.1

# Valkey port (1–65535)
NOCA_VALKEY_PORT=6379

# Valkey logical database index (0 or greater)
NOCA_VALKEY_DB=0

# (empty) Valkey username for ACL authentication; leave empty if auth is not configured
NOCA_VALKEY_USER=

# (empty) Valkey password; leave empty if auth is not configured
NOCA_VALKEY_PASSWORD=

# How often the app pings Valkey and attempts reconnection (1–300 s)
NOCA_VALKEY_HEALTHCHECK_INTERVAL_SECONDS=5  # 1 to 300 seconds

# Seconds to wait for PostgreSQL/Valkey at startup before aborting (0 = no wait)
NOCA_STARTUP_TIMEOUT_SECONDS=60

# --- Environment / logging ---
# Runtime environment (development/production)
NOCA_ENVIRONMENT=development

# Logging level honored by all modules: DEBUG, INFO, WARNING, ERROR, CRITICAL
# When unset, falls back to DEBUG in development and INFO in production
NOCA_LOG_LEVEL=
