# NOCA -- Build-time settings
#
# NOT an env_file layer and never loaded at runtime: consumed by
# containers/build.sh. Keep these in the project-root .env.
#
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Git tag of ioi/isolate compiled into noca/isolate-base
JUDGE_ISOLATE_TAG=v2.7

# Registry prefix applied to every built image tag (e.g. ghcr.io/myorg/noca)
NOCA_IMAGE_PREFIX=noca

# Build-script image naming mode: path or flat
NOCA_IMAGE_NAMING=path
