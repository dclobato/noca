# NOCA -- Shared HTTP-server settings
#
# Reverse-proxy trust, browser security headers, the public /health rate limit,
# and the footer link to the uptime dashboard. Read by all four HTTP modules.
#
# Loaded by: animator, arena, healthmonitor, web
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# --- Health rate limiting ---
# Enable public /health endpoint rate limiting in Web, Arena, and Animator
NOCA_HEALTH_RATE_LIMIT_ENABLED=true

# Fixed-window length in seconds for /health rate limiting
NOCA_HEALTH_RATE_LIMIT_WINDOW_SECONDS=60

# Maximum public /health requests per client IP in each window
NOCA_HEALTH_RATE_LIMIT_MAX_REQUESTS=30

# CIDRs that bypass /health rate limiting, usually local probe networks.
# Every *_TRUSTED_CIDRS value below REPLACES its default rather than appending to it: to
# exempt one more address keep the loopback entries, e.g. 127.0.0.0/8,::1/128,200.241.240.1/32.
# Matched against the client IP after trusted-proxy processing (NOCA_FORWARDED_ALLOW_IPS), never
# X-Forwarded-For. See "Trusted CIDRs" in docs/CONFIG.md.
NOCA_HEALTH_RATE_LIMIT_TRUSTED_CIDRS=127.0.0.0/8,::1/128

# --- Security headers and auth throttling ---
# Enable browser security headers on Web, Arena, animator and health monitor
# responses (one unprefixed setting governs every HTTP module)
NOCA_SECURITY_HEADERS_ENABLED=true

# Start CSP in report-only mode; set false only after validating asset coverage
NOCA_CSP_REPORT_ONLY=true

# Comma-separated trusted reverse proxy IPs/CIDRs for X-Forwarded-* headers
# Also honoured by the Animator (its reveal-control audit log records the client IP)
# Use '*' only in trusted private networks — it trusts any upstream IP
NOCA_FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- Health monitor link ---
# (empty) Public URL of the health monitor uptime dashboard, e.g. https://status.example.com
# Rendered as the "Status" link in the Web, Arena, and Animator footers; hidden when empty
NOCA_HEALTHMON_URL=
