# NOCA -- Landing page
#
# The standalone Caddy entry point. No Python, no database, no Valkey.
#
# Loaded by: landingpage
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Internal Caddy listener port (1-65535); the sample Compose stack publishes it on host port 84
NOCA_LANDINGPAGE_PORT=8080

# (required) Public URL of the Contest Web deployment
NOCA_LANDINGPAGE_WEB_URL=

# (required) Public URL of the Arena deployment
NOCA_LANDINGPAGE_ARENA_URL=

# (required) Public URL of the Animator deployment
NOCA_LANDINGPAGE_ANIMATOR_URL=

# (required) Public URL of the Health Monitor deployment
NOCA_LANDINGPAGE_HEALTHMON_URL=

# (required) Release tag shown in the landing page footer, e.g. the deployed git tag
# (max 32 chars, no whitespace)
NOCA_LANDINGPAGE_VERSION=
