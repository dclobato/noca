# NOCA -- Outbound-email contract
#
# Read by the two producers (Web, Arena) and by the mailer that drains their
# queue. How mail is actually delivered is the mailer's own file.
#
# Loaded by: arena, mailer, web
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# --- Email (producers: Web and Arena) ---
# Web and Arena never talk to a mail provider: every email is rendered, budgeted, and
# handed to the noca-mailer worker over Valkey. Whether it is really sent, and through
# what, is the mailer's decision -- see its section. A queue that cannot take a message
# is reported as a delivery failure; without a running mailer, mail waits until its TTL.
# Default From address every queued message carries
NOCA_EMAIL_SENDER=no-reply@noca.local

# (empty) Optional From display name; falls back to the module brand name
NOCA_EMAIL_SENDER_NAME=

# Seconds a queued email may wait for the mailer before it is dropped unsent (min 60)
NOCA_EMAIL_QUEUE_JOB_TTL_SECONDS=3600

# Per-actor outbound-email budget, counted when an email is handed to the service (fails open)
NOCA_EMAIL_BUDGET_ENABLED=true

# Fixed-window length in seconds for the email budget
NOCA_EMAIL_BUDGET_WINDOW_SECONDS=600

# Emails one user / anonymous IP / reset recipient may trigger per window; 0 disables the tier
NOCA_EMAIL_BUDGET_USER_MAX=20

# Emails one admin or teacher may trigger per window (sized for a batch send); 0 disables the tier
NOCA_EMAIL_BUDGET_ADMIN_MAX=200
