# NOCA -- Bundled PostgreSQL server
#
# The *server* side of the database, in the variable names the official postgres
# image reads. NOCA's own side is .env.database.full, in NOCA_DB_* names.
#
# These two files describe the same database from two ends and must agree:
# POSTGRES_USER with NOCA_DB_USER, POSTGRES_PASSWORD with NOCA_DB_PASSWORD, and
# POSTGRES_DB with NOCA_DB_NAME. They are separate files rather than one derived
# from the other because deriving needs `${...}` interpolation, which Compose
# resolves from the project-root .env and never from an env_file -- so a derived
# value would silently be the interpolation default while the layer's real value
# sat unread. A deployment using an external PostgreSQL drops this file and the
# bundled service with it.
#
# Loaded by: postgres (the bundled server container only)
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# (required) Must equal NOCA_DB_USER in .env.database.full
POSTGRES_USER=

# (required) Must equal NOCA_DB_PASSWORD in .env.database.full
POSTGRES_PASSWORD=

# (required) Must equal NOCA_DB_NAME in .env.database.full
POSTGRES_DB=
