# NOCA -- Development tooling
#
# NOT an env_file layer. Read by scripts/generate_backlog_index.py and the
# Playwright checks in tests/browser/. No deployment ever needs them.
#
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Read by scripts/generate_backlog_index.py, which regenerates docs/BACKLOG.md
# from the Gitea issues labelled `backlog`. No application module reads these,
# so a deployment never needs them.
#
# The repository is private, so the issues API refuses anonymous reads and the
# token is required. A read-only token scoped to `read:issue` is enough -- the
# generator only ever GETs. Keep it out of .env.full itself and out of any
# committed file; set it in .env, which is gitignored.
GITEA_TOKEN=

# Instance base URL. Only needed when the repository is not on the default host.
GITEA_URL=https://git.lobato.org:10880

# Credentials the Playwright UI checks in tests/browser/ log in with. The checks
# are SKIPPED unless both are set, so a normal `uv run pytest` is unaffected.
# They drive a *running* dev server, which is the only way to catch defects that
# exist solely in the browser -- a control that renders but does nothing, an
# editor that paints blank inside a hidden tab. Point them at a development
# instance: they log in as a real user.
NOCA_UI_CHECK_USERNAME=

NOCA_UI_CHECK_PASSWORD=

# Where those checks point. Defaults match the development ports, so they only
# need setting when a server runs elsewhere.
NOCA_UI_CHECK_ARENA_URL=http://127.0.0.1:8001

NOCA_UI_CHECK_WEB_URL=http://127.0.0.1:8000

# Contest slug for the Web (contest admin) checks. The Web editor lives under
# /c/{slug}/, so its checks are skipped unless a slug names an existing contest.
NOCA_UI_CHECK_WEB_SLUG=

# Web and Arena are separate identity domains, and the Contest checks sign in as
# an UberAdmin -- rarely the same account as an Arena login. Set this pair when
# they differ; leave it blank to reuse NOCA_UI_CHECK_USERNAME / _PASSWORD.
NOCA_UI_CHECK_WEB_USERNAME=

NOCA_UI_CHECK_WEB_PASSWORD=
