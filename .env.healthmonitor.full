# NOCA -- Health monitor
#
# The public uptime dashboard (noca-healthmonitor). Valkey only: no database,
# no JWT, no cookies.
#
# Loaded by: healthmonitor
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Reads only Valkey (common NOCA_VALKEY_* variables); no database or JWT configuration.
# Also honours the common NOCA_FORWARDED_ALLOW_IPS so Uvicorn trusts X-Forwarded-* headers
# from the reverse proxy.
# Bind address for the health monitor HTTP server
# Keep 0.0.0.0 in container deployments: Caddy connects over the container network
# and the container healthcheck probes loopback
NOCA_HEALTHMON_HOST=0.0.0.0

# TCP port for the health monitor HTTP server (1-65535); also drives the Caddy upstream and healthcheck
NOCA_HEALTHMON_PORT=8002

# Seconds between up/down probes of the monitored services (30 s to 1 h)
NOCA_HEALTHMON_PROBE_INTERVAL=300

# Seconds between cleanup passes deleting uptime slots older than the retention window (1 h to 1 week)
NOCA_HEALTHMON_REAPER_INTERVAL=43200

# Days of per-slot uptime history kept for the heatmap (7 to 90)
NOCA_HEALTHMON_RETENTION_DAYS=30

# Brand name shown on the monitor pages
NOCA_HEALTHMON_BRAND_NAME=NOCA Health monitor

# Enable per-IP rate limiting of the public dashboard routes (/, /refresh, /uptime.json);
# /health uses the shared NOCA_HEALTH_RATE_LIMIT_* settings instead
NOCA_HEALTHMON_RATE_LIMIT_ENABLED=true

# Dashboard requests accepted per client IP in each fixed window, shared by the three routes
# (one idle tab issues four per minute)
NOCA_HEALTHMON_RATE_LIMIT_MAX_REQUESTS=120

# Fixed-window length in seconds for dashboard rate limiting
NOCA_HEALTHMON_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated CIDRs exempt from dashboard rate limiting (internal scrapers, loopback)
NOCA_HEALTHMON_RATE_LIMIT_TRUSTED_CIDRS=127.0.0.0/8,::1/128
