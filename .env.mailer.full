# NOCA -- Mailer worker
#
# The single-replica outbound-email worker (noca-mailer) -- the only NOCA
# process that talks to a mail provider.
#
# Loaded by: mailer
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# The one process in NOCA that talks to a mail provider. Drains the Valkey mail queue the
# Web and Arena processes fill; whether mail is really sent, and through what, is decided
# here and only here. Reads the common NOCA_DB_* and NOCA_VALKEY_* variables and the
# producers' NOCA_EMAIL_SENDER / NOCA_EMAIL_QUEUE_JOB_TTL_SECONDS. Run one replica: the
# pace is per process.
# --- Provider ---
# Deliver for real; when false (or the provider is mock) each message goes to the worker's log
NOCA_SEND_EMAIL=false

# Backend the worker delivers through: mock or smtp
NOCA_EMAIL_PROVIDER=mock

# (empty) SMTP relay hostname (required with NOCA_SEND_EMAIL=true and provider smtp)
NOCA_SMTP_SERVER=

# SMTP port (1-65535)
NOCA_SMTP_PORT=587

# Use STARTTLS
NOCA_SMTP_USE_TLS=true

# (empty) SMTP username
NOCA_SMTP_USERNAME=

# (empty) SMTP password
NOCA_SMTP_PASSWORD=

# (empty) Absolute directory for the mbox audit log of delivered emails; empty disables logging
NOCA_EMAIL_MBOX_LOG_DIR=

# --- Delivery ---
# Deployment-wide delivery pace: rest 60/N seconds after every attempt (1-6000)
NOCA_MAILER_MAX_PER_MINUTE=60

# Seconds between queue polls while the pending queue is empty (0.5-60)
NOCA_MAILER_POLL_INTERVAL_SECONDS=2

# Fallback From display name when NOCA_EMAIL_SENDER_NAME is empty
NOCA_MAILER_BRAND_NAME=NOCA

# --- Reaper ---
# Seconds after which an inflight job is stale; also the retry delay after a provider refusal (>= 30)
NOCA_MAILER_STALE_THRESHOLD_SECONDS=300

# Seconds between reaper scans for stale inflight jobs (>= 5)
NOCA_MAILER_REAPER_INTERVAL_SECONDS=60

# Times a stale job is re-enqueued before being dropped (1-20)
NOCA_MAILER_MAX_REQUEUE_COUNT=3

# --- Presence and healthcheck ---
# (empty) Stable worker id; defaults to <fqdn>:<pid>
NOCA_MAILER_WORKER_ID=

# Seconds between Valkey worker-presence heartbeats (1-300)
NOCA_MAILER_PRESENCE_INTERVAL_SECONDS=30

# TTL of the presence live marker; must exceed the interval (2-3600)
NOCA_MAILER_PRESENCE_TTL_SECONDS=60

# Absolute path touched while the worker is healthy (read by python -m mailer.healthcheck)
NOCA_MAILER_HEARTBEAT_FILE=/tmp/mailer-heartbeat

# How often the heartbeat file is refreshed (1-300)
NOCA_MAILER_HEARTBEAT_INTERVAL_SECONDS=10

# Heartbeat age after which the container is unhealthy; must exceed the interval (2-3600)
NOCA_MAILER_HEARTBEAT_STALE_SECONDS=30

# --- Pause/resume (needs the common NOCA_WORKER_COMMAND_SECRET) ---
# Seconds between pause/resume command-key polls (0.5-60)
NOCA_MAILER_WORKER_COMMAND_POLL_SECONDS=3

# Freshness window for accepting a signed command (1-300)
NOCA_MAILER_WORKER_COMMAND_FRESHNESS_SECONDS=30

# TTL of the single-use command nonce; must exceed the freshness window (2-3600)
NOCA_MAILER_WORKER_COMMAND_NONCE_TTL_SECONDS=60
