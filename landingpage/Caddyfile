:{$NOCA_LANDINGPAGE_PORT:8080} {
	@method_not_allowed not method GET HEAD
	handle @method_not_allowed {
		header Allow "GET, HEAD"
		respond 405
	}

	handle /health {
		header Content-Type "application/json"
		respond `{"status":"ok"}` 200
	}

	header {
		-Server
		defer
	}
	header X-Content-Type-Options "nosniff"
	header X-Frame-Options "DENY"
	header Referrer-Policy "no-referrer"
	header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
	header Cross-Origin-Opener-Policy "same-origin"

	# The page carries its own stylesheet, scripts, and webfonts, and reaches
	# nothing else. connect-src 'none' is deliberate: the landing page must not be
	# able to call into the deployment it advertises.
	header Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; object-src 'none'"

	# Cache lifetime is set by three matchers that never overlap. An unmatched
	# default plus narrower overrides does not work here: every `header` directive
	# sets the field, so the broadest one wins regardless of source order.
	#
	# The page is rendered per request from the environment and is never stored.
	# Webfont filenames carry a content hash and are safe to pin. The stylesheet,
	# scripts, and images do not, so they revalidate hourly.
	@page path /
	header @page Cache-Control "no-store"

	@webfonts path /static/webfonts/*
	header @webfonts Cache-Control "public, max-age=2592000, immutable"

	@assets path /static/css/* /static/js/* /static/img/* /static/vendor/* /static/favicon.svg /favicon.ico
	header @assets Cache-Control "public, max-age=3600"

	root * /srv
	templates
	file_server
}
