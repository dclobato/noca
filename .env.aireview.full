# NOCA -- Arena <-> AI assistant contract
#
# The two settings the Arena app and the AI review worker must agree on. The
# OpenAI key itself lives in .env.aiassistant.full and reaches only that worker.
#
# Loaded by: aiassistant, arena
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Dotenv file holding secrets-manager keys (used by arena and aiassistant)
NOCA_CRYPTO_ENV_FILE=.env.crypto

# Seconds between scans for pending OpenAI batch jobs
NOCA_AI_BATCH_POLL_INTERVAL_SECONDS=300.0  # 60 to 3600 s
