# NOCA -- Autojudge worker
#
# The sandboxed compile/execute worker (noca-autojudge).
#
# Loaded by: autojudge
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Uses NOCA_PROBLEM_TESTCASE_DIR from the shared problem storage section above
# Maximum number of simultaneous container executions on this host
NOCA_JUDGE_WORKER_CONCURRENCY=4

# (empty) Stable identity string for this worker process. Defaults to <fqdn>:<pid>
NOCA_JUDGE_WORKER_ID=

# Seconds between worker-presence updates in Valkey (1–300 s)
NOCA_JUDGE_PRESENCE_INTERVAL_SECONDS=30.0

# TTL for the live worker marker (2–3600 s)
NOCA_JUDGE_PRESENCE_TTL_SECONDS=60

# Seconds between Valkey pause/resume command-key polls
NOCA_JUDGE_WORKER_COMMAND_POLL_SECONDS=3.0

# Symmetric freshness window for accepting a signed worker command
NOCA_JUDGE_WORKER_COMMAND_FRESHNESS_SECONDS=30.0

# TTL for the single-use worker command nonce
NOCA_JUDGE_WORKER_COMMAND_NONCE_TTL_SECONDS=60

# When true, each language's container pool is lazily filled on first submission
NOCA_JUDGE_PRE_WARM_CONTAINERS=true

# Number of warm idle containers maintained per language
NOCA_JUDGE_POOL_SIZE_PER_LANGUAGE=2

# Upper-bound memory limit applied to pool containers (MB)
NOCA_JUDGE_CONTAINER_MEM_LIMIT_MB=512

# Upper-bound PID limit applied to pool containers
NOCA_JUDGE_CONTAINER_PID_LIMIT=256

# Maximum seconds to wait for a warm container from the pool
NOCA_JUDGE_POOL_ACQUIRE_TIMEOUT_S=30.0

# --- Execution Limits ---
# Absolute path to the isolate binary inside run containers
NOCA_JUDGE_ISOLATE_BINARY_PATH=/usr/local/bin/isolate

# Distinct isolate box-ids the worker allocates from (0 .. value-1). Each live run
# container holds one unique box-id for its lifetime so concurrent containers never
# collide on the shared host cgroup box-N. Must not exceed isolate's num_boxes (default
# 1000); assumes a single autojudge worker process per host.
NOCA_JUDGE_ISOLATE_MAX_BOXES=1000

# Multiplier applied to CPU time limit to compute the inner wall-time budget
NOCA_JUDGE_ISOLATE_WALL_TIME_MULTIPLIER=3.0

# Multiplier applied to wall-time budget for outer timeout
NOCA_JUDGE_OUTER_TIMEOUT_MULTIPLIER=2.0

# Fixed seconds added to the wall-time budget as a floor under the outer timeout. The outer
# timeout bounds a whole Docker exec round trip, whose overhead is unrelated to the problem's
# time limit, so a purely multiplicative value fires on Docker latency alone for short budgets
# (repetitions reach that regime by design). Never reaches the contestant: isolate enforces
# --time/--wall-time inside the container.
NOCA_JUDGE_OUTER_TIMEOUT_FIXED_OVERHEAD_S=5.0

# Global ceiling for the compile phase in seconds
NOCA_JUDGE_COMPILE_TIMEOUT_S=180.0

# Global hard ceiling for stdout handling per test case in bytes
NOCA_JUDGE_OUTPUT_LIMIT_BYTES=67108864  # 64 MiB

# How many bytes of contestant stdout to persist
NOCA_JUDGE_STDOUT_EXCERPT_BYTES=8192

# How many bytes of contestant stderr to persist
NOCA_JUDGE_STDERR_EXCERPT_BYTES=4096

# Hard CPU-time ceiling applied to profiling
NOCA_JUDGE_PROFILING_MAX_CPU_TIME_SEC=30.0

# Hard wall-time ceiling reserved for profiling runs
NOCA_JUDGE_PROFILING_MAX_WALL_TIME_SEC=90.0

# Hard memory ceiling used while profiling
NOCA_JUDGE_PROFILING_MAX_MEMORY_MB=2048

# Hard process/thread ceiling used while profiling
NOCA_JUDGE_PROFILING_MAX_PIDS=256

# Hard stdout ceiling used while profiling
NOCA_JUDGE_PROFILING_MAX_OUTPUT_BYTES=67108864  # 64 MiB

# --- Idempotency Lock ---
# TTL in seconds for the per-judgment Redis idempotency lock
NOCA_JUDGE_LOCK_TTL_SECONDS=660

# --- Reaper ---
# How often the reaper scans the in-flight sorted set for stale jobs
NOCA_JUDGE_REAPER_INTERVAL_S=30.0

# Dispatched job older than this many minutes is considered stale
NOCA_JUDGE_REAPER_STALE_THRESHOLD_MINUTES=5.0

# Maximum number of times reaper will requeue a stale job
NOCA_JUDGE_REAPER_MAX_REQUEUE_COUNT=3

# How often the reconciler re-scans the DB for lost non-terminal jobs
NOCA_JUDGE_RECONCILER_INTERVAL_S=120.0

# --- Heartbeat ---
# Absolute path to the heartbeat file
NOCA_JUDGE_HEARTBEAT_FILE=/tmp/autojudge-heartbeat

# How often the worker refreshes the heartbeat file in seconds
NOCA_JUDGE_HEARTBEAT_INTERVAL_S=10.0

# Maximum allowed age of the heartbeat file before unhealthy
NOCA_JUDGE_HEARTBEAT_STALE_THRESHOLD_S=30.0

# --- Metrics ---
# Expose a Prometheus /metrics HTTP endpoint
NOCA_JUDGE_METRICS_ENABLED=true

# TCP port the worker binds for Prometheus scraping
NOCA_JUDGE_METRICS_PORT=9101

# --- Docker ---
# Docker daemon socket or TCP address
NOCA_JUDGE_DOCKER_BASE_URL=unix:///var/run/docker.sock

# Network mode for judge containers
NOCA_JUDGE_DOCKER_NETWORK=none

# (empty) Optional AppArmor profile for run containers
# Set to 'unconfined' on Ubuntu hosts where AppArmor blocks isolate mount privatization
NOCA_JUDGE_DOCKER_APPARMOR_PROFILE=

# Emergency wall-clock watchdog for one complete custom-validator interaction
NOCA_JUDGE_CUSTOM_VALIDATOR_WATCHDOG_SECONDS=300

# --- Canonical Judge Image Sync ---
# (empty) Canonical registry/repository prefix for judge images
# e.g. ghcr.io/dclobato/noca or docker.io/dclobato/noca
NOCA_JUDGE_IMAGE_REGISTRY=

# Image naming mode for canonical judge refs
# path => ghcr.io/org/repo/judge-... ; flat => docker.io/org/repo-judge-...
NOCA_JUDGE_IMAGE_NAMING=path

# (empty) Optional tag suffix appended to compile/run image tags, e.g. v5.0.0
NOCA_JUDGE_IMAGE_TAG=

# Startup behavior when canonical image sync is enabled
NOCA_JUDGE_IMAGE_PULL_POLICY=missing
