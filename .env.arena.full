# NOCA -- Arena module
#
# The public Arena participant platform (noca-arena).
#
# Loaded by: arena
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Distinct accounts an address must have failed against, on top of the IP ceiling
# above, before the Arena login 2FA step locks that address. Reaching that step
# needs a valid password, so one account's failures are someone fumbling a code
# while spraying spans many; 1 restores the plain per-IP count
NOCA_AUTH_RATE_LIMIT_2FA_IP_DISTINCT_ACCOUNTS=3

# Bind address for the arena HTTP server
# Keep 0.0.0.0 in container deployments: Caddy connects over the container network
NOCA_ARENA_HOST=0.0.0.0

# TCP port for the arena HTTP server (1-65535); also drives the Caddy upstream
NOCA_ARENA_PORT=8001

# JWT issuer and reverse-geocoder identity; must differ from NOCA_WEB_APP_NAME
NOCA_ARENA_APP_NAME=noca-arena

# Public brand name shown in UI, titles, footer, 2FA issuer, and Arena emails
NOCA_ARENA_BRAND_NAME=NOCA Arena

# (empty) Public base URL for Arena emails, e.g. https://arena.example.com
# Leave empty to derive from the incoming request — may produce incorrect URLs behind a reverse proxy
NOCA_ARENA_URL_BASE=

# Maximum password age in days before a warning flash is shown at login
NOCA_ARENA_PASSWORD_MAX_AGE=0

# Google sign-in: an alternative Arena login door, off by default
# While false every /auth/google route answers 404 and no Google button is rendered,
# so a deployment without an OAuth client behaves exactly as before the feature existed
NOCA_ARENA_GOOGLE_OAUTH_ENABLED=false

# (empty) OAuth 2.0 client ID and secret from the Google Cloud Console
# Both are required when NOCA_ARENA_GOOGLE_OAUTH_ENABLED is true; Arena refuses to start otherwise
# The redirect URI is derived from NOCA_ARENA_URL_BASE (<base>/auth/google/callback),
# never configured here, so it cannot drift from the deployment's own base URL --
# register exactly that value as an Authorized redirect URI in the Google console
NOCA_ARENA_GOOGLE_OAUTH_CLIENT_ID=

NOCA_ARENA_GOOGLE_OAUTH_CLIENT_SECRET=

# Submission rate limiting (admins and judges are exempt)
NOCA_ARENA_RATE_LIMIT_WINDOW_MINUTES=5

NOCA_ARENA_RATE_LIMIT_MAX_SUBMISSIONS=10

# Loose per-user ceiling on Arena's polled partials and authenticated reads
# (notifications, presence, live feed, submission status, problem/profile/ranking
# pages). Generous on purpose: honest clients poll these every few seconds
NOCA_ARENA_USER_READ_RATE_LIMIT_ENABLED=true

NOCA_ARENA_USER_READ_RATE_LIMIT_MAX_REQUESTS=300

NOCA_ARENA_USER_READ_RATE_LIMIT_WINDOW_SECONDS=60

# --- Per-problem download limit ---
# Tight per-user budget on GET /problems/{n}/export and /problems/{n}/sample-testcases.zip,
# stacked under the loose ceiling above. Building a package or a sample archive is
# expensive and both routes are reachable by every logged-in user. Applies whether or
# not the artifact is served from cache.
NOCA_ARENA_PROBLEM_EXPORT_RATE_LIMIT_ENABLED=true

# Problem downloads accepted per user in each window (a user downloads a problem once)
NOCA_ARENA_PROBLEM_EXPORT_RATE_LIMIT_MAX_REQUESTS=10

# Fixed-window length in seconds for per-user problem downloads
NOCA_ARENA_PROBLEM_EXPORT_RATE_LIMIT_WINDOW_SECONDS=600

# --- Admin export limit ---
# Per-user budget on the Arena admin downloads: the full problem package
# (GET /admin/problems/{id}/export) and the security-events CSV
# (GET /admin/dashboard/security-events.csv), bucket arena:admin-export.
NOCA_ARENA_ADMIN_EXPORT_RATE_LIMIT_ENABLED=true

# Admin downloads accepted per user in each window
NOCA_ARENA_ADMIN_EXPORT_RATE_LIMIT_MAX_REQUESTS=20

# Fixed-window length in seconds
NOCA_ARENA_ADMIN_EXPORT_RATE_LIMIT_WINDOW_SECONDS=600

# --- Teacher report limit ---
# Per-user budget on the teacher problem-set report pages and the class CSV
# under /classes/{id}/problem-sets/... (bucket arena:teacher-report). Each
# aggregates a class's submissions per hit; looser than the downloads because
# a teacher browses and re-sorts them as pages.
NOCA_ARENA_TEACHER_REPORT_RATE_LIMIT_ENABLED=true

# Report page loads and CSV downloads accepted per user in each window
NOCA_ARENA_TEACHER_REPORT_RATE_LIMIT_MAX_REQUESTS=60

# Fixed-window length in seconds
NOCA_ARENA_TEACHER_REPORT_RATE_LIMIT_WINDOW_SECONDS=600

# --- Public problem package cache ---
# (required in production) Directory caching the per-problem public export and
# sample-case ZIPs served to every logged-in user. Absolute path; created at startup.
# Each artifact is built once and reused until the problem changes. Arena REFUSES TO
# START in production when this is empty: a package build per request is never
# acceptable there. When empty outside production, every download rebuilds.
NOCA_ARENA_PUBLIC_PROBLEM_PACK_PATH=

# Signup attempts accepted per client IP in each fixed window. Counted once a
# submission passes form validation and reaches the account lookup, the paid
# reputation calls, the insert and the activation email -- so a form fumble
# costs nothing -- and not reset by success; gated by NOCA_AUTH_RATE_LIMIT_ENABLED
NOCA_ARENA_SIGNUP_RATE_LIMIT_MAX_REQUESTS=5

# Total POST /auth/signup requests accepted per client IP in each window, counted
# before validation. A flood guard well above the attempt budget above
NOCA_ARENA_SIGNUP_REQUEST_RATE_LIMIT_MAX_REQUESTS=60

# Fixed-window length in seconds, shared by both signup windows
NOCA_ARENA_SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600

# Seconds a student must wait after a denied class registration request before requesting
# the same class again (each request emails the teacher); 0 disables the wait
NOCA_ARENA_CLASS_REGISTRATION_RETRY_SECONDS=86400

# Cap POST /submissions/{id}/request-ai-review per user (counted before any lookup)
NOCA_ARENA_AI_REVIEW_RATE_LIMIT_ENABLED=true

# AI review requests accepted per user in each fixed window, whatever the outcome
NOCA_ARENA_AI_REVIEW_RATE_LIMIT_MAX_REQUESTS=30

# Fixed-window length in seconds for per-user AI review request limiting
NOCA_ARENA_AI_REVIEW_RATE_LIMIT_WINDOW_SECONDS=600

# Seconds after POST /admin/problems/{id}/rejudge-all during which another rejudge-all
# of the same problem is refused. 0 disables.
NOCA_ARENA_REJUDGE_COOLDOWN_SECONDS=300

# Days a user must wait between username changes. 0 disables the cooldown. The
# username is the pseudonym an age-shielded user is published under, so
# unlimited churn would let an observer correlate old and new handles across the
# public ranking and undo the pseudonymity.
NOCA_ARENA_USERNAME_CHANGE_COOLDOWN_DAYS=30

# Throttle POST /user/profile/location/detect, the reverse-geocoder proxy. The
# upstream policy is per application, so a per-user cap alone cannot honour it:
# the deployment-wide pacing and budget below are the real protection, and they
# fail closed (503, no upstream call) on any Valkey failure. There is no switch
# to turn them off -- NOCA_ARENA_REVERSE_GEOCODER_ENABLED disables the proxy
# itself, and more headroom comes from raising the ceilings below
# Location detections accepted per user in each fixed window, cache hits included
NOCA_ARENA_GEOCODE_RATE_LIMIT_USER_MAX_REQUESTS=5

# Fixed-window length in seconds for per-user location detection limiting
NOCA_ARENA_GEOCODE_RATE_LIMIT_USER_WINDOW_SECONDS=3600

# Upstream geocoder calls the whole deployment may make in each global window
NOCA_ARENA_GEOCODE_RATE_LIMIT_GLOBAL_MAX_REQUESTS=30

# Fixed-window length in seconds for the deployment-wide geocoder budget
NOCA_ARENA_GEOCODE_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60

# Minimum seconds between two upstream geocoder calls across the deployment.
# Nominatim's own policy is one request per second. 0 disables pacing and is only
# appropriate for a self-hosted provider; the windowed budget above still applies
NOCA_ARENA_GEOCODE_RATE_LIMIT_GLOBAL_MIN_INTERVAL_SECONDS=1

# How long a reverse-geocoded 0.001-degree cell (about 100 m) stays cached
NOCA_ARENA_GEOCODE_CACHE_TTL_SECONDS=86400

# Maximum finalized submissions returned by the public Arena live feed
NOCA_ARENA_LIVE_FEED_LIMIT=20

# Last ranking position awarded each medal on the leaderboard and /ranking pages
# (0-1000; 0 disables the band; values must not decrease, ignoring disabled bands)
NOCA_ARENA_RANKING_MEDAL_GOLD_CUTOFF=1

NOCA_ARENA_RANKING_MEDAL_SILVER_CUTOFF=2

NOCA_ARENA_RANKING_MEDAL_BRONZE_CUTOFF=3

# Enable the online-presence green dot on Arena user avatars. This governs the
# dot only: the client heartbeat runs either way, because it is also what keeps
# a sliding Arena session alive on a page left open without navigating
NOCA_ARENA_PRESENCE_ENABLED=true

# Seconds a user stays online after their last heartbeat or page view
NOCA_ARENA_PRESENCE_TTL_SECONDS=60

# Client heartbeat and dot-refresh interval in seconds. Used as the heartbeat
# cadence only while presence is enabled; with presence off the keepalive falls
# back to NOCA_JWT_EXPIRE_SECONDS / 4 (minimum 60 s)
NOCA_ARENA_PRESENCE_HEARTBEAT_SECONDS=30

# (empty) Stable identity for the worker-presence keys. Defaults to <fqdn>:<pid>
NOCA_ARENA_WORKER_ID=

# Seconds between worker-presence updates in Valkey (1–300 s)
NOCA_ARENA_WORKER_PRESENCE_INTERVAL_SECONDS=30.0

# TTL for the live worker marker (2–3600 s); must exceed the interval
NOCA_ARENA_WORKER_PRESENCE_TTL_SECONDS=60

# Security-events retention reaper interval in seconds (1 hour to 7 days)
NOCA_ARENA_SECURITY_EVENTS_REAPER_INTERVAL_SECONDS=86400

# Enables Arena profile browser-coordinate reverse geocoding
NOCA_ARENA_REVERSE_GEOCODER_ENABLED=true

# Reverse-geocoder endpoint
NOCA_ARENA_REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse

# Optional User-Agent sent to the reverse geocoder; defaults to NOCA_ARENA_APP_NAME/app_version when unset
NOCA_ARENA_REVERSE_GEOCODER_USER_AGENT=

# --- SSE connection limits ---
# Cap concurrent SSE streams (per client IP, per user) across this module's event routes
NOCA_ARENA_SSE_LIMIT_ENABLED=true

# Open SSE streams allowed per client IP. A shared NAT counts as one client and every
# contestant page holds two streams, so this is a venue's budget (~100 machines), not a client's
NOCA_ARENA_SSE_MAX_PER_IP=200

# Open SSE streams allowed per authenticated user, across IPs
NOCA_ARENA_SSE_MAX_PER_USER=10

# Lease lifetime in Valkey of one held slot; renewed while the stream is open
NOCA_ARENA_SSE_CONNECTION_TTL_SECONDS=600

# Comma-separated CIDRs exempt from the SSE caps (loopback, trusted venue network)
NOCA_ARENA_SSE_TRUSTED_CIDRS=127.0.0.0/8,::1/128

# --- Arena Admin Bootstrap ---
# Container startup creates an ARENA_ADMIN account only when NOCA_ARENA_ADMIN_EMAIL is set.
# The script is idempotent — if the email already exists it exits cleanly.
# (empty) Full name for the bootstrap Arena admin account
NOCA_ARENA_ADMIN_FULLNAME=

# (empty) Email address for the bootstrap Arena admin account (setting this triggers the bootstrap)
NOCA_ARENA_ADMIN_EMAIL=

# (empty) Password for the bootstrap Arena admin account
NOCA_ARENA_ADMIN_PASSWORD=
