{
	log default {
		level INFO
	}

	log reverse_proxy_quiet {
		level ERROR
		include http.handlers.reverse_proxy
	}
}

(noca-upstream) {
	# Dynamically names the log file based on the second snippet argument
	log {
		output file /var/log/caddy/access-{args[1]}.log {
			roll_size 100MB
			roll_keep 20
			roll_keep_for 185d
		}
	}

	log_append request_id {http.request.uuid}

	header {
		X-Request-ID {http.request.uuid}
	}

	reverse_proxy {args[0]} {
		# A bare (unprefixed) header_up is a SET, which already replaces any
		# client-supplied value. Do NOT add a `header_up -X-Request-ID` strip
		# line: Caddy applies header ops as add -> set -> delete, so a named
		# delete runs AFTER the set and would wipe the UUID before proxying.
		header_up X-Request-ID {http.request.uuid}
		# Trusted client source port for audit correlation; pair with
		# NOCA_SOURCE_PORT_HEADER=X-Source-Port on the web/arena services.
		header_up X-Source-Port {remote_port}
	}
}

:80 {
	import noca-upstream web:8000 web
}

:81 {
	import noca-upstream arena:8001 arena
}

:82 {
	import noca-upstream healthmonitor:8002 healthmonitor
}
