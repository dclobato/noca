services:
  caddy:
    image: caddy:2-alpine
    depends_on:
      web:
        condition: service_started
      arena:
        condition: service_started
      healthmonitor:
        condition: service_started
      animator:
        condition: service_started
    environment:
      # Caddy resolves the {$VAR:default} upstream ports in containers/Caddyfile from
      # its own environment, so these must mirror the values the services bind.
      #
      # Literals, not ${...}: Compose resolves interpolation from the project-root
      # .env and never from an env_file, so reading these from .env.web.full and
      # friends is impossible -- the reference would quietly yield the default while
      # the layer's value went unread. In this stack the four services are private
      # behind Caddy, so their ports are a property of the stack: they are pinned
      # here, in each service's `environment:`, in `ports:`, and in the healthchecks,
      # and tests/test_deployment_ports.py holds all of those equal to the settings
      # defaults. Change an internal port here rather than in a template.
      NOCA_WEB_PORT: "8000"
      NOCA_ARENA_PORT: "8001"
      NOCA_HEALTHMON_PORT: "8002"
      NOCA_ANIMATOR_PORT: "8003"
    ports:
      - "80:80"
      - "81:81"
      - "82:82"
      - "83:83"
      # To enable automatic TLS later, also publish 443:443 and update
      # containers/Caddyfile to use real hostnames instead of ports 80-83.
    volumes:
      - ./containers/Caddyfile:/etc/caddy/Caddyfile:ro
      - ${NOCA_DATA_ROOT:-.}/caddy_logs:/var/log/caddy
    networks:
      - noca-network
    restart: unless-stopped

  landingpage:
    image: noca/landingpage
    build:
      context: .
      dockerfile: containers/landingpage/Dockerfile
    env_file:
      - .env.landingpage.full
    # The four URLs and the version tag have no usable default, so
    # containers/landingpage/entrypoint.sh refuses to start Caddy when one is
    # missing, relative, or carries whitespace. Fill them in .env.landingpage.full.
    environment:
      # Pinned for the same reason the other services' ports are: `ports:` below
      # is interpolated by Compose, which cannot read an env_file.
      NOCA_LANDINGPAGE_PORT: "8080"
    ports:
      - "84:8080"
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "wget -q -O /dev/null http://localhost:8080/health",
        ]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 5s
    networks:
      - noca-network
    restart: unless-stopped

  web:
    image: noca/webapp
    build:
      context: .
      dockerfile: containers/webapp/Dockerfile
    env_file:
      - .env.common.full
      - .env.database.full
      - .env.http.full
      - .env.webarena.full
      - .env.email.full
      - .env.storage.full
      - .env.web.full
    environment:
      # Only values that are true *because* this is a container: everything else
      # comes from the .env.*.full layers above. An entry here overrides them all.
      PUID: ${PUID:-1000}
      PGID: ${PGID:-100}
      # Keep the bind address at 0.0.0.0 in this stack: Caddy reaches `web` over the
      # container network, and the container healthcheck probes loopback. A narrower
      # bind is only useful when running `uv run noca-web` directly on a host.
      NOCA_WEB_HOST: 0.0.0.0
      NOCA_WEB_PORT: "8000"
      NOCA_DB_SERVER: postgres
      NOCA_VALKEY_SERVER: valkey
      # In this compose stack, `web` is only reachable via the internal network behind
      # Caddy. Keep explicit values in production when direct access is possible.
      NOCA_FORWARDED_ALLOW_IPS: "*"
      # Must match the volume mounts below, not a host path.
      NOCA_WEB_PROBLEM_STATEMENT_DIR: /data/problem_statements
      NOCA_PROBLEM_TESTCASE_DIR: /data/problem_test_cases
      NOCA_WEB_PUBLIC_PROBLEM_PACK_PATH: /data/problem_packs
      NOCA_SEED_LANGUAGES: ${NOCA_SEED_LANGUAGES:-false}
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "/app/.venv/bin/python -m web.healthcheck",
        ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    volumes:
      # Host directory names are the backup script's contract: it archives
      # problem_statements, problem_testcases, and email_log relative to the
      # project directory. See scripts/backup_noca.sh.
      - ${NOCA_DATA_ROOT:-.}/problem_statements:/data/problem_statements
      - ${NOCA_DATA_ROOT:-.}/problem_testcases:/data/problem_test_cases
      - ${NOCA_DATA_ROOT:-.}/problem_packs_web:/data/problem_packs
    networks:
      - noca-network
    restart: unless-stopped

  arena:
    image: noca/arena
    build:
      context: .
      dockerfile: containers/arena/Dockerfile
    env_file:
      - .env.common.full
      - .env.database.full
      - .env.http.full
      - .env.webarena.full
      - .env.email.full
      - .env.storage.full
      - .env.aireview.full
      - .env.workers.full
      - .env.arena.full
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-100}
      # Keep the bind address at 0.0.0.0 in this stack: Caddy reaches `arena` over the
      # container network. A narrower bind is only useful when running `uv run noca-arena`
      # directly on a host.
      NOCA_ARENA_HOST: 0.0.0.0
      NOCA_ARENA_PORT: "8001"
      NOCA_DB_SERVER: postgres
      NOCA_VALKEY_SERVER: valkey
      # In this compose stack, `arena` is only reachable via the internal network behind Caddy.
      # Keep explicit values in production instead of '*' when direct access is possible.
      NOCA_FORWARDED_ALLOW_IPS: "*"
      # Must match the read-only mount below, not a host path.
      NOCA_CRYPTO_ENV_FILE: /app/.env.crypto
      NOCA_PROBLEM_TESTCASE_DIR: /data/problem_test_cases
      NOCA_ARENA_PUBLIC_PROBLEM_PACK_PATH: /data/problem_packs
      NOCA_SEED_LANGUAGES: ${NOCA_SEED_LANGUAGES:-false}
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "/app/.venv/bin/python -m arena.healthcheck",
        ]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s
    volumes:
      - ./.env.crypto:/app/.env.crypto:ro
      # Arena writes its own problems' test cases under the shared root's
      # `arena/` subdirectory, so this mount is read-write like Web's. The
      # setting is a DirectoryPath: without the mount Arena refuses to start.
      - ${NOCA_DATA_ROOT:-.}/problem_testcases:/data/problem_test_cases
      - ${NOCA_DATA_ROOT:-.}/problem_packs_arena:/data/problem_packs
    networks:
      - noca-network
    restart: unless-stopped

  autojudge:
    image: noca/autojudge
    build:
      context: .
      dockerfile: containers/autojudge/Dockerfile
    env_file:
      - .env.common.full
      - .env.database.full
      - .env.storage.full
      - .env.workers.full
      - .env.autojudge.full
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-100}
      NOCA_DB_SERVER: postgres
      NOCA_VALKEY_SERVER: valkey
      # Must match the read-only mount below, not a host path.
      NOCA_PROBLEM_TESTCASE_DIR: /data/problem_test_cases
      NOCA_JUDGE_DOCKER_BASE_URL: unix:///var/run/docker.sock
      NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT: ${NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT:-300}
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "python -m autojudge.healthcheck",
        ]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 30s
    group_add:
      - "${DOCKER_GID:-989}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ${NOCA_DATA_ROOT:-.}/problem_testcases:/data/problem_test_cases:ro
    networks:
      - noca-network
    restart: unless-stopped

  rating:
    image: noca/rating
    build:
      context: .
      dockerfile: containers/rating/Dockerfile
    env_file:
      - .env.common.full
      - .env.database.full
      - .env.rating.full
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-100}
      NOCA_DB_SERVER: postgres
      NOCA_VALKEY_SERVER: valkey
      NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT: ${NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT:-300}
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "/app/.venv/bin/python -m rating.healthcheck",
        ]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      - noca-network
    restart: unless-stopped

  aiassistant:
    image: noca/aiassistant
    build:
      context: .
      dockerfile: containers/aiassistant/Dockerfile
    env_file:
      - .env.common.full
      - .env.database.full
      - .env.aireview.full
      - .env.workers.full
      - .env.aiassistant.full
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-100}
      NOCA_DB_SERVER: postgres
      NOCA_VALKEY_SERVER: valkey
      # Must match the read-only mount below, not a host path.
      NOCA_CRYPTO_ENV_FILE: /app/.env.crypto
      NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT: ${NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT:-300}
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "/app/.venv/bin/python -m aiassistant.healthcheck",
        ]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 30s
    volumes:
      - ./.env.crypto:/app/.env.crypto:ro
    networks:
      - noca-network
    restart: unless-stopped

  mailer:
    image: noca/mailer
    build:
      context: .
      dockerfile: containers/mailer/Dockerfile
    env_file:
      - .env.common.full
      - .env.database.full
      - .env.email.full
      - .env.workers.full
      - .env.mailer.full
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-100}
      NOCA_DB_SERVER: postgres
      NOCA_VALKEY_SERVER: valkey
      NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT: ${NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT:-300}
      # The mbox audit log of delivered mail. Off by default -- it records the
      # full body of every message, password-reset links included -- but the
      # directory is mounted either way, because scripts/backup_noca.sh requires
      # email_log to exist and archives it. Uncomment to enable:
      # NOCA_EMAIL_MBOX_LOG_DIR: /data/email_log
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "/app/.venv/bin/python -m mailer.healthcheck",
        ]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 30s
    volumes:
      - ${NOCA_DATA_ROOT:-.}/email_log:/data/email_log
    networks:
      - noca-network
    restart: unless-stopped

  healthmonitor:
    image: noca/healthmonitor
    build:
      context: .
      dockerfile: containers/healthmonitor/Dockerfile
    env_file:
      - .env.common.full
      - .env.http.full
      - .env.healthmonitor.full
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-100}
      # Keep the bind address at 0.0.0.0 in this stack: Caddy reaches `healthmonitor` over
      # the container network and the healthcheck below probes loopback. A narrower bind is
      # only useful when running `uv run noca-healthmonitor` directly on a host.
      NOCA_HEALTHMON_HOST: 0.0.0.0
      NOCA_HEALTHMON_PORT: "8002"
      NOCA_VALKEY_SERVER: valkey
      # In this compose stack, `healthmonitor` is only reachable via the internal network
      # behind Caddy. Keep explicit values in production when direct access is possible.
      NOCA_FORWARDED_ALLOW_IPS: "*"
    depends_on:
      valkey:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "curl -fsS http://localhost:8002/health >/dev/null",
        ]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    networks:
      - noca-network
    restart: unless-stopped

  animator:
    image: noca/animator
    build:
      context: .
      dockerfile: containers/animator/Dockerfile
    env_file:
      - .env.common.full
      - .env.database.full
      - .env.http.full
      - .env.animator.full
    environment:
      PUID: ${PUID:-1000}
      PGID: ${PGID:-100}
      # Keep the bind address at 0.0.0.0 in this stack: Caddy reaches `animator` over the
      # container network and the healthcheck below probes loopback. A narrower bind is
      # only useful when running `uv run noca-animator` directly on a host.
      NOCA_ANIMATOR_HOST: 0.0.0.0
      NOCA_ANIMATOR_PORT: "8003"
      NOCA_DB_SERVER: postgres
      NOCA_VALKEY_SERVER: valkey
      # Trust the Caddy reverse proxy so the reveal-control audit log records the
      # operator IP rather than the proxy's.
      NOCA_FORWARDED_ALLOW_IPS: "*"
      # The animator is a schema consumer: its entrypoint waits for web/arena to
      # migrate rather than migrating itself.
      NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT: ${NOCA_WAIT_FOR_MIGRATIONS_TIMEOUT:-300}
    depends_on:
      postgres:
        condition: service_healthy
      valkey:
        condition: service_healthy
    healthcheck:
      test:
        [
          "CMD-SHELL",
          "curl -fsS http://localhost:8003/health >/dev/null",
        ]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    networks:
      - noca-network
    restart: unless-stopped

  postgres:
    image: postgres:18-trixie
    # The server side of the database, in the postgres image's own variable names.
    # It cannot be derived from NOCA_DB_* with ${...}: Compose resolves that from
    # the project-root .env, never from the .env.database.full the application
    # services read, so the derivation would silently use the interpolation
    # default. The two files must agree; see .env.postgres.full.
    env_file:
      - .env.postgres.full
    # Server-wide autovacuum tuning. Per-table storage parameters (set by the
    # Alembic migration for high-churn tables) layer on top of these. The goal is
    # to run the launcher more often with more parallel workers and a higher cost
    # budget so vacuum/analyze keep pace with the submission/judging write load and
    # the bulk deletes performed by the retention reapers.
    command:
      - postgres
      - -c
      - autovacuum=on
      - -c
      - autovacuum_naptime=15s
      - -c
      - autovacuum_max_workers=4
      - -c
      - autovacuum_vacuum_cost_limit=2000
      - -c
      - autovacuum_vacuum_cost_delay=2ms
      - -c
      - autovacuum_vacuum_scale_factor=0.1
      - -c
      - autovacuum_analyze_scale_factor=0.05
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"]
      interval: 5s
      timeout: 5s
      retries: 10
    volumes:
      - postgres-data:/var/lib/postgresql
    networks:
      - noca-network
    restart: unless-stopped

  valkey:
    image: valkey/valkey:latest
    healthcheck:
      test: ["CMD", "valkey-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10
    # NOCA's Valkey is a coordination store (queues, locks, TTL markers, reveal
    # session state), not a blob cache, so `--maxmemory-policy noeviction` is
    # deliberate: under pressure a write fails loudly with an OOM error the
    # application can log, instead of an eviction policy silently discarding
    # queue entries, locks, or a live reveal ceremony.
    #
    # `--maxmemory` must stay comfortably below `mem_limit`: allocator
    # fragmentation, client output buffers, and the RDB fork's copy-on-write all
    # count against the cgroup limit but not against `maxmemory`. Setting the two
    # equal would reintroduce the kernel OOM kill this is meant to prevent.
    # See docs/CONFIG.md, "Valkey / Redis" -> "Server memory bounds".
    command:
      valkey-server --loglevel verbose --maxmemory 768mb --maxmemory-policy noeviction
    mem_limit: 1g   # Container ceiling; keep >= ~1.3x the --maxmemory above
    volumes:
      - valkey-data:/data
    networks:
      - noca-network
    restart: unless-stopped

volumes:
  postgres-data:
  valkey-data:

networks:
  noca-network:
    name: noca-network
