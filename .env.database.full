# NOCA -- PostgreSQL connection
#
# Every module except the health monitor, which reads Valkey only.
#
# Loaded by: aiassistant, animator, arena, autojudge, mailer, rating, web
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# Docker Compose: NOCA_DB_SERVER must be reachable from inside the container — do not use
# localhost unless the server runs in the same container namespace. Use the Compose service
# name (e.g. postgres) instead.

# (required) PostgreSQL username
NOCA_DB_USER=

# (required) PostgreSQL password
NOCA_DB_PASSWORD=

# (required) Hostname or IP of the PostgreSQL server (e.g. 127.0.0.1 or postgres)
# On Windows use 127.0.0.1 instead of localhost — asyncpg tries IPv6 first when given a hostname,
# causing a ~20s timeout before falling back to IPv4
NOCA_DB_SERVER=

# PostgreSQL port (1–65535)
NOCA_DB_PORT=5432

# (required) Name of the PostgreSQL database
NOCA_DB_NAME=
