# NOCA -- AI assistant worker
#
# The Arena AI review worker (noca-aiassistant).
#
# Loaded by: aiassistant
# Reference: docs/CONFIG.md -- layer map: docs/ENV_LAYERS.md

# --- OpenAI Integration ---
# Leave NOCA_AI_OPENAI_API_KEY empty to disable AI review for users without a personal key.
# Prices are per 1 million tokens in USD; update when the model pricing changes.
# (empty) Platform fallback OpenAI API key (sk-...)
NOCA_AI_OPENAI_API_KEY=

# OpenAI model identifier passed to the Responses API
NOCA_AI_OPENAI_MODEL=gpt-5.4-mini

# Maximum number of output tokens the AI may generate per review
NOCA_AI_OPENAI_MAX_OUTPUT_TOKENS=500

# Model reasoning effort: lower favors speed/lower token usage, higher favors
# more complete reasoning and higher-quality reviews (models reason adaptively).
# One of: none, low, medium, high, xhigh
NOCA_AI_OPENAI_REASONING_EFFORT=medium

# Price per 1 million input tokens in USD
NOCA_AI_OPENAI_INPUT_TOKEN_PRICE=0.75   # USD per 1M input tokens

# Price per 1 million output tokens in USD
NOCA_AI_OPENAI_OUTPUT_TOKEN_PRICE=4.5  # USD per 1M output tokens

# (empty) Batch input token price in USD per 1 million tokens
NOCA_AI_OPENAI_BATCH_INPUT_TOKEN_PRICE=

# (empty) Batch output token price in USD per 1 million tokens
NOCA_AI_OPENAI_BATCH_OUTPUT_TOKEN_PRICE=

# Stable identity. Defaults to `<fqdn>:<pid>` when empty
NOCA_AI_WORKER_ID=

# Seconds between worker-presence updates in Valkey (1–300 s)
NOCA_AI_PRESENCE_INTERVAL_SECONDS=30.0

# TTL for the live worker marker (2–3600 s)
NOCA_AI_PRESENCE_TTL_SECONDS=60

# Absolute path touched while the worker is healthy; the Compose healthcheck reads it
NOCA_AI_HEARTBEAT_FILE=/tmp/aiassistant-heartbeat

# How often the worker refreshes the heartbeat file (1–300 s)
NOCA_AI_HEARTBEAT_INTERVAL_SECONDS=10.0

# Maximum heartbeat-file age before the container is unhealthy (2–3600 s)
NOCA_AI_HEARTBEAT_STALE_SECONDS=30.0

# --- Queue Polling ---
# Seconds to sleep between poll attempts when the queue is empty
NOCA_AI_POLL_INTERVAL_SECONDS=5.0  # 0.5 to 60 s

# Hours before a non-terminal OpenAI batch job is expired locally (credit refunded,
# user notified, OpenAI batch cancelled and its files deleted)
NOCA_AI_BATCH_STALE_HOURS=24  # 1 to 168 h

# Seconds between Valkey pause/resume command-key polls
NOCA_AI_WORKER_COMMAND_POLL_SECONDS=3.0

# Symmetric freshness window for accepting a signed worker command
NOCA_AI_WORKER_COMMAND_FRESHNESS_SECONDS=30.0

# TTL for the single-use worker command nonce
NOCA_AI_WORKER_COMMAND_NONCE_TTL_SECONDS=60

# --- Reaper / Reconciler ---
# Age in seconds after which an in-flight AI review job is considered stale
NOCA_AI_STALE_THRESHOLD_SECONDS=300.0

# How often the reaper scans the inflight sorted set for stale jobs
NOCA_AI_REAPER_INTERVAL_SECONDS=60.0

# Maximum number of times a stale AI review job is requeued
NOCA_AI_MAX_REQUEUE_COUNT=3

# How often the reconciler sweeps PostgreSQL for lost AI jobs
NOCA_AI_RECONCILER_INTERVAL_SECONDS=120.0

# Minimum age in seconds since a submission was flagged before reconciler runs
NOCA_AI_RECONCILER_GRACE_SECONDS=120.0

# Maximum number of lost AI review jobs re-enqueued per sweep
NOCA_AI_RECONCILER_BATCH_SIZE=100
